{
  "name": "mpc-firewall",
  "version": "1.0.0",
  "private": true,
  "description": "On-chain RLP, ABI calldata, and Bitcoin raw-tx policy firewall eliminating the 32-byte blind-signing vulnerability in NEAR Chain Signatures (v1.signer).",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mpc-firewall/web dev",
    "build": "pnpm --filter @mpc-firewall/core build && pnpm --filter @mpc-firewall/web build",
    "start": "pnpm --filter @mpc-firewall/web start",
    "test": "pnpm --filter @mpc-firewall/core test",
    "typecheck": "pnpm --filter @mpc-firewall/core typecheck && pnpm --filter @mpc-firewall/web typecheck",
    "verify:judge": "node scripts/judge-demo.mjs",
    "test:e2e": "node scripts/test-e2e-http.mjs"
  }
}
