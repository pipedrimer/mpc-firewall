# ---------------------------------------------------------------------------
# MpcFirewall Configuration (Zero API keys required for local cryptographic
# decoding, policy simulation, and Rust/TS verification; add live keys below
# for remote NEAR AI Cloud TEE / OutLayer / NEAR Intents partner calls).
# ---------------------------------------------------------------------------

# 1. NEAR Chain Signatures & RPC
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
MPC_SIGNER_CONTRACT_ID=v1.signer-prod.testnet
MPC_FIREWALL_CONTRACT_ID=mpc-firewall.testnet
TREZU_DAO_ACCOUNT=mpc-firewall-council.sputnikv2.testnet
NEAR_TESTNET_RELAY_ACCOUNT_ID=relay.mpc-firewall.testnet
NEAR_TESTNET_RELAY_PRIVATE_KEY=

# 2. NEAR AI Cloud (Confidential Calldata vs. Intent Audit in TEE)
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
NEARAI_E2EE=true

# 3. NEAR Intents 1Click API (Cross-Chain Refuel & Route Verification)
NEAR_INTENTS_API_KEY=
NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com

# 4. OutLayer (Optional TEE Worker Policy Attestation)
OUTLAYER_API_KEY=
OUTLAYER_BASE_URL=https://testnet-api.outlayer.ai

# 5. Runtime Storage & Production Hardening Flags
# Leave unset to use .mpc-firewall-data locally (or os.tmpdir() on Netlify):
MPC_FIREWALL_DATA_DIR=
# Set an admin secret to require Bearer / x-admin-token auth on PATCH/POST /api/policy:
MPC_FIREWALL_ADMIN_TOKEN=
# Set true to fail-closed (503) if admin token is unset:
REQUIRE_ADMIN_AUTH=false
# Set true to fail-closed (ERR_TEE_UNAVAILABLE) if live NEAR AI Cloud TEE is unreachable:
STRICT_LIVE_TEE=false

